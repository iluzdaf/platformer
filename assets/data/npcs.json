{
    "boar":{
        "actorData":{
            "sheet":{"texture":"textures/boar.png","cellSize":[32,32]},
            "size":[16,16],
            "physicsBodyData":{"colliderSize":[14,10],"colliderOffset":[2,6]},
            "abilities":{"move":{"moveSpeed":180},"gravity":{},"charge":{}},
            "animationData":{
                "clips":{
                    "dead":{"frames":[7],"frameDuration":1,"loops":false},
                    "idle":{"frames":[0],"frameDuration":1},
                    "run":{"frames":[3,4,5,6],"frameDuration":0.08},
                    "sleep":{"frames":[1,2],"frameDuration":0.6},
                    "stunned":{"frames":[8,9],"frameDuration":0.3}
                },
                "rules":[
                    {"show":"dead","when":{"alive":false}},
                    {"show":"sleep","when":{"inState":"sleep"}},
                    {"show":"stunned","when":{"inState":"stunned"}},
                    {"show":"run","when":{"moving":true,"onGround":true}},
                    {"show":"idle","when":{"onGround":true}}
                ],
                "startClip":"sleep"
            }
        },
        "stateMachineBehaviorData":{
            "states":[
                {"name":"sleep"},
                {"name":"charge","does":{"kind":"attack","with":"charge"}},
                {"name":"stunned"}
            ],
            "transitions":[
                {"from":"sleep","to":"charge","when":{"heard":true,"near":true}},
                {"from":"charge","to":"stunned","when":{"charging":false}},
                {"from":"stunned","to":"charge","when":{"near":true},"after":1.5},
                {"from":"stunned","to":"sleep","when":{"near":false},"after":1.5}
            ]
        },
        "facts":{"heard":false,"near":false},
        "tuning":{"range":200},
        "script":"scripts/npcs/boar.lua"
    },
    "rat":{
        "actorData":{
            "sheet":{"texture":"textures/rat.png","cellSize":[32,32]},
            "size":[8,8],
            "physicsBodyData":{"colliderSize":[5,4],"colliderOffset":[2,4],"stepHeight":1},
            "abilities":{"move":{"moveSpeed":60},"gravity":{},"pounce":{"leap":[120,-60]}},
            "animationData":{
                "clips":{
                    "dead":{"frames":[7],"frameDuration":1,"loops":false},
                    "fall":{"frames":[6],"frameDuration":1},
                    "idle":{"frames":[0,1],"frameDuration":0.5},
                    "walk":{"frames":[2,3,4,5],"frameDuration":0.12}
                },
                "rules":[
                    {"show":"dead","when":{"alive":false}},
                    {"show":"fall","when":{"falling":true,"onGround":false}},
                    {"show":"walk","when":{"moving":true,"onGround":true}},
                    {"show":"idle","when":{"onGround":true}}
                ],
                "startClip":"idle"
            }
        },
        "stateMachineBehaviorData":{
            "states":[
                {"name":"patrol","does":{"kind":"patrol"}},
                {"name":"flee","does":{"kind":"script","call":"flee"}},
                {"name":"pounce","does":{"kind":"attack","with":"pounce"},"cooldown":1}
            ],
            "transitions":[
                {"from":"patrol","to":"flee","when":{"threatClose":true,"threatOnMySurface":true}},
                {"from":"flee","to":"patrol","when":{"threatOnMySurface":false},"after":1.5},
                {
                    "from":"flee",
                    "to":"pounce",
                    "when":{"cornered":true,"threatInReach":true,"threatOnMySurface":true}
                },
                {"from":"pounce","to":"flee","when":{"onGround":true},"after":0.1}
            ]
        },
        "senses":{"close":40,"reach":24},
        "script":"scripts/npcs/rat.lua"
    },
    "spider":{
        "actorData":{
            "sheet":{"texture":"textures/spider.png","cellSize":[32,32]},
            "size":[16,16],
            "physicsBodyData":{"colliderSize":[8,8],"colliderOffset":[4,8]},
            "abilities":{
                "move":{"moveSpeed":90},
                "jump":{"jumpSpeed":-320},
                "wallHang":{},
                "wallClimb":{"climbSpeed":70},
                "mantle":{},
                "gravity":{},
                "pounce":{}
            },
            "animationData":{
                "clips":{
                    "climb":{"frames":[8,9],"frameDuration":0.15},
                    "dead":{"frames":[10],"frameDuration":1,"loops":false},
                    "fall":{"frames":[6],"frameDuration":1},
                    "idle":{"frames":[0,1],"frameDuration":0.5},
                    "jump":{"frames":[6],"frameDuration":1},
                    "pounce":{"frames":[11,12],"loops":false},
                    "walk":{"frames":[2,3,4,5],"frameDuration":0.12},
                    "wallSlide":{"frames":[7],"frameDuration":1}
                },
                "rules":[
                    {"show":"dead","when":{"alive":false}},
                    {"show":"pounce","when":{"inState":"pounce"}},
                    {"show":"climb","when":{"climbing":true,"onGround":false}},
                    {"show":"wallSlide","when":{"onGround":false,"onWall":true}},
                    {"show":"jump","when":{"onGround":false,"rising":true}},
                    {"show":"fall","when":{"falling":true,"onGround":false}},
                    {"show":"walk","when":{"moving":true,"onGround":true}},
                    {"show":"idle","when":{"onGround":true}}
                ],
                "startClip":"idle"
            }
        },
        "stateMachineBehaviorData":{
            "states":[
                {"name":"patrol","does":{"kind":"patrol"}},
                {"name":"chase","does":{"kind":"chase","standoff":28}},
                {"name":"pounce","does":{"kind":"attack","with":"pounce"},"cooldown":2}
            ],
            "transitions":[
                {"from":"patrol","to":"chase","when":{"threatClose":true,"threatOnMySurface":true}},
                {"from":"chase","to":"patrol","when":{"threatOnMySurface":false},"after":2},
                {
                    "from":"chase",
                    "to":"pounce",
                    "when":{"threatInReach":true,"threatOnMySurface":true}
                },
                {"from":"pounce","to":"chase","when":{"onGround":true},"after":0.1}
            ]
        },
        "senses":{"close":64,"reach":40},
        "script":"scripts/npcs/spider.lua"
    }
}