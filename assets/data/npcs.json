{
    "rat":{
        "actorData":{
            "sheet":{"texture":"textures/rat.png","cellSize":[32,32]},
            "size":[8,8],
            "physicsBodyData":{"colliderSize":[5,4],"colliderOffset":[2,4],"stepHeight":1},
            "motionData":{
                "moveAbilityData":{"moveSpeed":60},
                "gravityAbilityData":{},
                "pounceAbilityData":{"leap":[120,-60]}
            },
            "animationData":{
                "clips":{
                    "dead":{"frames":[7],"frameDuration":1,"loops":false},
                    "fall":{"frames":[6],"frameDuration":1},
                    "idle":{"frames":[0,1],"frameDuration":0.5},
                    "walk":{"frames":[2,3,4,5],"frameDuration":0.12}
                },
                "ladder":{
                    "transitions":[
                        {"to":"dead","when":{"alive":false}},
                        {"to":"fall","when":{"falling":true,"onGround":false}},
                        {"to":"walk","when":{"moving":true,"onGround":true}},
                        {"to":"idle","when":{"onGround":true}}
                    ]
                }
            }
        },
        "stateMachineBehaviorData":{
            "states":[
                {"name":"patrol","does":{"kind":"patrol"}},
                {"name":"flee","does":{"kind":"flee"}},
                {"name":"pounce","does":{"kind":"attack","with":"pounce"},"cooldown":1}
            ],
            "transitions":[
                {"from":"patrol","to":"flee","when":{"threatOnMySurface":true,"threatWithin":40}},
                {"from":"flee","to":"patrol","when":{"threatOnMySurface":false},"after":1.5},
                {
                    "from":"flee",
                    "to":"pounce",
                    "when":{"cornered":true,"threatOnMySurface":true,"threatWithin":24}
                },
                {"from":"pounce","to":"flee","when":{"onGround":true},"after":0.1}
            ]
        },
        "script":"scripts/npcs/rat.lua"
    },
    "spider":{
        "actorData":{
            "sheet":{"texture":"textures/spider.png","cellSize":[32,32]},
            "size":[16,16],
            "physicsBodyData":{"colliderSize":[8,8],"colliderOffset":[4,8]},
            "motionData":{
                "moveAbilityData":{"moveSpeed":90},
                "jumpAbilityData":{"jumpSpeed":-320},
                "wallHangAbilityData":{},
                "wallClimbAbilityData":{"climbSpeed":70},
                "mantleAbilityData":{},
                "gravityAbilityData":{},
                "pounceAbilityData":{}
            },
            "animationData":{
                "clips":{
                    "climb":{"frames":[8,9],"frameDuration":0.15},
                    "dead":{"frames":[10],"frameDuration":1,"loops":false},
                    "fall":{"frames":[6],"frameDuration":1},
                    "idle":{"frames":[0,1],"frameDuration":0.5},
                    "jump":{"frames":[6],"frameDuration":1},
                    "pounce":{"frames":[11,12],"loops":false},
                    "walk":{"frames":[2,3,4,5],"frameDuration":0.12},
                    "wallSlide":{"frames":[7],"frameDuration":1}
                },
                "ladder":{
                    "transitions":[
                        {"to":"dead","when":{"alive":false}},
                        {"to":"pounce","when":{"inState":"pounce"}},
                        {"to":"climb","when":{"climbing":true,"onGround":false}},
                        {"to":"wallSlide","when":{"onGround":false,"onWall":true}},
                        {"to":"jump","when":{"onGround":false,"rising":true}},
                        {"to":"fall","when":{"falling":true,"onGround":false}},
                        {"to":"walk","when":{"moving":true,"onGround":true}},
                        {"to":"idle","when":{"onGround":true}}
                    ]
                }
            }
        },
        "stateMachineBehaviorData":{
            "states":[
                {"name":"patrol","does":{"kind":"patrol"}},
                {"name":"chase","does":{"kind":"chase","standoff":28}},
                {"name":"pounce","does":{"kind":"attack","with":"pounce"},"cooldown":2}
            ],
            "transitions":[
                {"from":"patrol","to":"chase","when":{"threatOnMySurface":true,"threatWithin":64}},
                {"from":"chase","to":"patrol","when":{"threatOnMySurface":false},"after":2},
                {"from":"chase","to":"pounce","when":{"threatOnMySurface":true,"threatWithin":40}},
                {"from":"pounce","to":"chase","when":{"onGround":true},"after":0.1}
            ]
        },
        "script":"scripts/npcs/spider.lua"
    }
}