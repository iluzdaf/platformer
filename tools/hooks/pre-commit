#!/usr/bin/env python3
"""Formats staged json assets so the repository keeps one format.

Installed by tools/hooks/install.py as a plain .git/hooks file rather than
through core.hooksPath, which would bypass this repository's LFS hooks.
"""

import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
FORMATTER = ROOT / "tools" / "format_json.py"


def git(*args):
    return subprocess.run(
        ["git", *args], cwd=ROOT, capture_output=True, text=True, check=True
    ).stdout.splitlines()


def main():
    staged = [
        path
        for path in git("diff", "--cached", "--name-only", "--diff-filter=ACM")
        if path.startswith("assets/") and path.endswith(".json")
    ]
    if not staged:
        return 0

    # Re-adding a file with unstaged edits would sweep them into the commit,
    # so those are reported instead.
    dirty = set(git("diff", "--name-only"))
    clean = [path for path in staged if path not in dirty]
    partial = [path for path in staged if path in dirty]

    if clean:
        formatting = subprocess.run(
            [sys.executable, str(FORMATTER), "--format", *clean], cwd=ROOT
        )
        if formatting.returncode != 0:
            return formatting.returncode

        git("add", *clean)

    if partial:
        listed = " ".join(partial)
        print(f"pre-commit: left as staged, they have unstaged edits: {listed}", file=sys.stderr)
        print(f"pre-commit: run python3 tools/format_json.py --format {listed}", file=sys.stderr)

    return 0


if __name__ == "__main__":
    sys.exit(main())
